# Required only for the weekly discovery workflow.
OPENAI_API_KEY=

# Cost-conscious current model for weekly scans; override when needed.
OPENAI_MODEL=gpt-5.6-luna

# Used by the static generator for canonical links and the header source link.
SITE_URL=http://localhost:8000
REPOSITORY_URL=https://github.com/owner/deploy-index

# GitHub Actions provides GITHUB_TOKEN automatically.
GITHUB_TOKEN=
