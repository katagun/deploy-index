    "cost_predictability": "Relative bill predictability, from 1 (highly variable) to 5 (mostly fixed).",
    "control": "Relative infrastructure and runtime control, from 1 (abstracted) to 5 (deep control).",
    "portability": "Relative ease of leaving or reproducing the workload elsewhere, from 1 to 5.",
    "maturity": "Relative product and operating-history maturity, from 1 to 5.",
    "global_reach": "Relative multi-region and edge reach, from 1 to 5.",
    "enterprise_readiness": "Relative governance, networking, and enterprise-operating fit, from 1 to 5."
  },
